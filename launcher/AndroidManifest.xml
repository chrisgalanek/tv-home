<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mihir.tvhome"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Search only: TMDB titles, people and where-to-watch, plus their posters. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app menu open Android's uninstall confirmation (the user still confirms). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keeps the daily art download (ArtDownloader) scheduled after the TV restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reads the alarm list (dumpsys alarm) for when the sleep timer turns the TV off, shown on the
         Sleep button (SleepTimer). Developer permissions, granted over ADB by build-and-install.sh. -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Android also requires usage access to show the alarm list. Granted over ADB with DUMP. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Apps that can search their own catalogue ("Search in ..." on Recently watched). -->
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="com.sony.dtv.tvlin" />
        <package android:name="com.android.vending" />
        <package android:name="com.sony.dtv.timers" />
    </queries>

    <application
        android:label="Home"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/ic_home"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <!-- Hold Up in any app for a drop-down bar with the home screen's top buttons (TopBarService).
             An accessibility service, so the owner switches it on: Settings → System → Accessibility. -->
        <service
            android:name=".TopBarService"
            android:exported="true"
            android:label="Home: top bar"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/top_bar_service" />
        </service>

        <!-- Daily download of new art pictures for the background (ArtDownloader). -->
        <service
            android:name=".ArtDownloader"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The screensaver on demand: the home screen's Screensaver button. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Home"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <!-- Screensaver: the home screen's art pictures (ArtDream). Settings → Screen saver, or set
             over ADB by build-and-install.sh. -->
        <service
            android:name=".ArtDream"
            android:exported="true"
            android:label="Christian art"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Sees what's playing for "Recently watched" (see WatchListener). Enabled over ADB. -->
        <service
            android:name=".WatchListener"
            android:exported="true"
            android:label="Home: recently watched"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
